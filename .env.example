# ==============================================================================
# ORCA 2.0 — Environment Configuration
# ==============================================================================

# Data Mode: DEMO (safe offline simulated data) or LIVE (Copernicus / Open-Meteo)
ORCA_DATA_MODE=DEMO

# ------------------------------------------------------------------------------
# TextBee SMS Gateway Configuration (https://textbee.dev)
# ------------------------------------------------------------------------------
# API key generated in your TextBee dashboard
TEXTBEE_API_KEY=

# Optional: ID of the specific registered Android device in TextBee (omit for default)
TEXTBEE_DEVICE_ID=

# ------------------------------------------------------------------------------
# SOS Emergency Dispatch Contacts
# ------------------------------------------------------------------------------
# Central Operations Admin phone numbers (receives ALL distress transmissions)
# Multiple numbers can be separated by commas (e.g. +919876543210, +919876543211)
ORCA_ADMIN_PHONES=+919876543210

# Default Indian Coast Guard responder contact (used when per-station override is empty)
ORCA_COAST_GUARD_DEFAULT_PHONE=+919339698196

# Optional Coast Guard Station Collaborator Phone Overrides:
# ORCA_CG_MUMBAI_PHONE=+919339698196
# ORCA_CG_GOA_PHONE=+919339698196
# ORCA_CG_KOCHI_PHONE=+919339698196
# ORCA_CG_CHENNAI_PHONE=+919339698196
# ORCA_CG_VIZAG_PHONE=+919339698196
# ORCA_CG_PARADIP_PHONE=+919339698196
# ORCA_CG_VERAVAL_PHONE=+919339698196
# ORCA_CG_HALDIA_PHONE=+919339698196
# ORCA_CG_PORTBLAIR_PHONE=+919339698196

# ------------------------------------------------------------------------------
# Secondary Fallback Provider (Twilio — Optional)
# ------------------------------------------------------------------------------
ORCA_SMS_ACCOUNT_SID=
ORCA_SMS_AUTH_TOKEN=
ORCA_SMS_FROM=

# ------------------------------------------------------------------------------
# AI Voice / Intelligence Engine (Groq — https://console.groq.com)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
ORCA_GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# Copernicus Marine Earth Observation (Optional for live currents & chlorophyll)
# https://marine.copernicus.eu
# ------------------------------------------------------------------------------
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

